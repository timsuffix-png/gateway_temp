{
  "name": "gateway_temp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preload": "tsc src/electron/preload.ts --outDir electron/dist/electron",
    "watch:preload": "tsc -p tsconfig.json --watch",
    "start": "next start",
    "lint": "next lint",
    "start-electron": "electron src/electron/main.js",
    "e": "concurrently \"npm run dev\" \"npm run start-electron\"",
    "builder": "npm run build && electron ."
  },
  "dependencies": {
    "axios": "^1.11.0",
    "next": "15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.10.1",
    "serialport": "^13.0.0",
    "sweetalert2": "^11.22.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  }
}
